# Backend API (FastAPI /ask). Local or cloudflared tunnel URL.
VITE_API_URL=http://localhost:8000

# Shared token sent as auth header to the backend (spec §13-3).
VITE_API_TOKEN=

# Firebase (metadata-only history — no RFP/answer bodies, spec §13-3).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
